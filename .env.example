# Copy to .env (gitignored) and fill in. Loaded by config.py at import, and
# passed into the container by docker-compose.yml; a variable already set in
# the real environment takes precedence.

# The Apertus endpoint, as three variables (the Hack Apertus convention).
# When all three are set they are the default router and HyDE model. Any
# OpenAI-compatible endpoint serving Apertus; CSCS is what every result used.
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=

# Without LLM_*: Apertus v1.5 on CSCS (the Swiss National Supercomputing
# Centre, which does not record prompts or responses), the registry's
# apertus-v15 / apertus-v15-70b. Created under ui.inference.cscs.ch.
CSCS_INFERENCE_API_KEY=

# Only to rerun the Apertus 2509 rows (HF Inference Providers). A
# fine-grained token with "Make calls to Inference Providers" is enough.
HF_TOKEN=

# Only for the Claude comparator column of the eval matrix.
ANTHROPIC_API_KEY=

# Not used: publicAI's v1.5 ids serve other models (PLAN.md, Risk 1). Kept
# so the recorded serving probe can be rerun.
PUBLICAI_API_KEY=

# Optional: override the web UI's caps, e.g. to trigger reduced mode on purpose.
# MEDITATIONS_WEB_DAILY_LLM_CALLS=200
# MEDITATIONS_WEB_SESSION_QUERIES_PER_HOUR=10
