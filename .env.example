# Copy to .env (gitignored) and fill in. Loaded by config.py at import;
# a variable already set in the real environment takes precedence.

# Default LLM path (Apertus via HuggingFace Inference). A fine-grained token
# with only "Make calls to Inference Providers" is enough. Optional if you
# have run `hf auth login`, which stores a token huggingface_hub finds itself.
HF_TOKEN=

# Apertus v1.5 directly from publicAI's own gateway (api.publicai.co), where
# the v1.5 models are served; HF Inference Providers has no live provider for
# them. Created under platform.publicai.co, Settings, API keys.
PUBLICAI_API_KEY=

# Only for the Claude comparator column of the eval matrix.
ANTHROPIC_API_KEY=
